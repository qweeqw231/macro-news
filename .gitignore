node_modules/
logs/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本地调试用
_*.html

# 取数缓存（src/em.mjs 的磁盘缓存，按 TTL 复用接口结果）
# 不进 git：它是本机加速用的派生数据，提交只会让仓库平白变大
.cache/

# 一次性探针脚本（tmp/ 下的调研脚本，不属于产品代码）
tmp/

# 本地新闻数据库（独立于静态站，绝不进 git）
.local/

# wrangler 本地构建/状态缓存
.wrangler/

# 浏览器实测/调试截图
.screenshots/

# 一次性日期产物目录（如 2026-11-15/ 的容量分析、归档低产审计）
# 只匹配仓库根下的 YYYY-MM-DD/ 目录；产物按需留在磁盘，不参与版本控制
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# TRAE 生成的 HTML 分享包（可由 index.html 重新打包）
.trae-html-share-packages/
